# Environment overrides — copy to .env and fill in your values.

# Inference device: "cpu", "cuda", or "mps"
DEVICE=cpu

# Path to the YOLOv8 player model weights (default: auto-download yolov8n.pt)
YOLOV8_PLAYER_WEIGHTS=

# Path to the fine-tuned tennis ball YOLOv8 weights
YOLOV8_BALL_WEIGHTS=

# API server settings
API_HOST=0.0.0.0
API_PORT=8000
